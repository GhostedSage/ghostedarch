pkgname=ghostedarch-wallpaper
pkgver=1.0.0
pkgrel=1
pkgdesc="Official wallpapers and branding visual assets for the GhostedArch Linux distribution"
arch=('any')
url="https://github.com/GhostedSage/ghostedarch"
license=('custom')
source=("ghostedarch-wallpaper.png")
sha256sums=('SKIP')

package() {
  # Install default branding wallpaper to system background directory
  install -dm755 "${pkgdir}/usr/share/backgrounds/ghostedarch"
  install -m644 ghostedarch-wallpaper.png "${pkgdir}/usr/share/backgrounds/ghostedarch/ghostedarch-wallpaper.png"
  
  # Dynamically install all custom wallpapers added to the wallpaper folder
  if [ -d "$startdir/wallpaper" ]; then
    echo " ==> Packaging custom user wallpapers from wallpaper directory..."
    install -m644 "$startdir/wallpaper"/* "${pkgdir}/usr/share/backgrounds/ghostedarch/"
  fi

  # Symlink as default wallpaper
  install -dm755 "${pkgdir}/usr/share/backgrounds"
  ln -sf ghostedarch/ghostedarch-wallpaper.png "${pkgdir}/usr/share/backgrounds/ghostedarch-default.png"
}
