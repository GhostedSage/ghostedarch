# Self-contained binary package — all files are bundled alongside this PKGBUILD.

pkgname=ghostedctl
pkgver=0.1.0
pkgrel=1
pkgdesc="Unified command-line interface and diagnostic tool for Ghosted Arch"
arch=('x86_64')
url="https://github.com/BishalPoudel-1/ghostedarch-tools"
license=('GPL-3.0')

depends=('glibc')
options=('!debug' '!strip' '!buildflags')

source=("ghostedctl")
sha256sums=('SKIP')

package() {
    install -Dm755 "$srcdir/ghostedctl" "$pkgdir/usr/bin/ghostedctl"
}
