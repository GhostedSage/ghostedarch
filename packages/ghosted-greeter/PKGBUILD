# Maintainer: Bishal Poudel <bishalpoudel884@gmail.com>
#
# Self-contained binary package — all files are bundled alongside this PKGBUILD.

pkgname=ghosted-greeter
pkgver=0.1.0
pkgrel=1
pkgdesc="Modern, hardware-accelerated Qt6/QML & Rust graphical login manager for greetd"
arch=('x86_64')
url="https://github.com/BishalPoudel-1/ghostedarch-tools"
license=('GPL-3.0')
install=ghosted-greeter.install

depends=(
    'greetd'
    'cage'
    'qt6-base'
    'qt6-declarative'
    'qt6-5compat'
    'systemd'
    'polkit'
)
backup=(
    'etc/ghosted/greeter.toml'
    'etc/greetd/config.toml'
)
options=('!debug' '!strip' '!buildflags')

source=(
    "ghosted-greeter"
    "ghosted-greeter.toml"
    "greetd-config.toml"
    "40-ghosted-greeter.rules"
    "20-quiet-printk.conf"
)
sha256sums=(
    'SKIP'
    'SKIP'
    'SKIP'
    'SKIP'
    'SKIP'
)

package() {
    install -Dm755 "$srcdir/ghosted-greeter" "$pkgdir/usr/bin/ghosted-greeter"

    install -dm755 "$pkgdir/usr/share/ghosted-greeter"
    cp -r "$startdir/assets" "$startdir/qml" "$startdir/scripts" "$pkgdir/usr/share/ghosted-greeter/"
    chmod -R a+rx "$pkgdir/usr/share/ghosted-greeter"

    install -Dm644 "$srcdir/ghosted-greeter.toml" "$pkgdir/etc/ghosted/greeter.toml"
    install -Dm644 "$srcdir/greetd-config.toml" "$pkgdir/etc/greetd/config.toml"
    install -Dm644 "$srcdir/40-ghosted-greeter.rules" "$pkgdir/etc/polkit-1/rules.d/40-ghosted-greeter.rules"
    install -Dm644 "$srcdir/20-quiet-printk.conf" "$pkgdir/etc/sysctl.d/20-quiet-printk.conf"
}
