# Maintainer: Bishal Poudel <bishalpoudel884@gmail.com>
pkgname=ghosted-greeter
pkgver=0.1.0
pkgrel=1
pkgdesc="Modern, hardware-accelerated Qt6/QML & Rust graphical login manager for greetd"
arch=('x86_64')
url="https://github.com/BishalPoudel-1/ghostedarch-tools"
license=('GPL-3.0')
install=ghosted-greeter.install

depends=(
    'greetd'
    'cage'
    'qt6-base'
    'qt6-declarative'
    'qt6-5compat'
    'systemd'
    'polkit'
)
makedepends=(
    'cargo'
    'git'
    'pkgconf'
    'gcc'
)
backup=(
    'etc/ghosted/greeter.toml'
    'etc/greetd/config.toml'
)
source=("git+https://github.com/BishalPoudel-1/ghostedarch-tools.git#branch=main")
sha256sums=('SKIP')

build() {
    cd "$srcdir/ghostedarch-tools/ghostedland/ghosted-loginmanager"
    cargo build --release --locked
}

package() {
    cd "$srcdir/ghostedarch-tools/ghostedland/ghosted-loginmanager"

    # Install binary
    install -Dm755 "target/release/ghosted-greeter" "$pkgdir/usr/bin/ghosted-greeter"

    # Install QML, assets, and session launcher scripts
    install -dm755 "$pkgdir/usr/share/ghosted-greeter"
    cp -r assets qml scripts "$pkgdir/usr/share/ghosted-greeter/"
    chmod -R a+rx "$pkgdir/usr/share/ghosted-greeter"

    # Install default greeter configuration
    install -Dm644 "ghosted-greeter.toml" "$pkgdir/etc/ghosted/greeter.toml"

    # Install greetd daemon configuration
    install -Dm644 "packaging/greetd-config.toml" "$pkgdir/etc/greetd/config.toml"

    # Install polkit rule for unprivileged reboot/shutdown from greeter
    install -Dm644 "packaging/40-ghosted-greeter.rules" "$pkgdir/etc/polkit-1/rules.d/40-ghosted-greeter.rules"

    # Install silent boot console settings
    install -Dm644 "packaging/20-quiet-printk.conf" "$pkgdir/etc/sysctl.d/20-quiet-printk.conf"
}

