# Self-contained binary package — all files are bundled alongside this PKGBUILD.

pkgname=ghosted-wallpaper
pkgver=0.1.0
pkgrel=1
pkgdesc="High-performance Wayland multi-output wallpaper daemon for Ghosted Arch"
arch=('x86_64')
url="https://github.com/BishalPoudel-1/ghostedarch-tools"
license=('GPL-3.0')

depends=('wayland')
options=('!debug' '!strip' '!buildflags')

source=("ghosted-wallpaper")
sha256sums=('SKIP')

package() {
    install -Dm755 "$srcdir/ghosted-wallpaper" "$pkgdir/usr/bin/ghosted-wallpaper"
}
