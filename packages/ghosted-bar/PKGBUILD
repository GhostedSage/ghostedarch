# Maintainer: Bishal Poudel <bishalpoudel884@gmail.com>
#
# Self-contained binary package — all files are bundled alongside this PKGBUILD.
# No internet access or Rust toolchain required at build time.

pkgname=ghosted-bar
pkgver=0.1.0
pkgrel=3
pkgdesc="Modern, high-performance Wayland status bar and Control Center for Ghosted Arch"
arch=('x86_64')
url="https://github.com/BishalPoudel-1/ghostedarch-tools"
license=('GPL-3.0')

depends=(
    'wayland'
    'vulkan-icd-loader'
    'libxkbcommon'
    'fontconfig'
    'freetype2'
    'brightnessctl'
    'power-profiles-daemon'
    'bluez'
    'networkmanager'
)
options=('!debug' '!strip' '!buildflags')

source=(
    "ghosted-bar"
    "ghosted-bar.desktop"
    "pinned.json"
)
sha256sums=(
    'SKIP'
    'SKIP'
    'SKIP'
)

package() {
    install -Dm755 "$srcdir/ghosted-bar" "$pkgdir/usr/bin/ghosted-bar"
    install -Dm644 "$srcdir/ghosted-bar.desktop" "$pkgdir/usr/share/applications/ghosted-bar.desktop"

    install -dm755 "$pkgdir/usr/share/ghosted-bar"
    install -m644 "$srcdir/pinned.json" "$pkgdir/usr/share/ghosted-bar/pinned.json.example"
}
