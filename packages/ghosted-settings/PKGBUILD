# Maintainer: Bishal Poudel <bishalpoudel884@gmail.com>
#
# Self-contained binary package — all files are bundled alongside this PKGBUILD.

pkgname=ghosted-settings
pkgver=0.1.0
pkgrel=2
pkgdesc="GTK4 and libadwaita desktop settings application for Ghosted Arch"
arch=('x86_64')
url="https://github.com/BishalPoudel-1/ghostedarch-tools"
license=('GPL-3.0')
provides=('ghosted-setting')
conflicts=('ghosted-setting')

depends=(
    'gtk4'
    'libadwaita'
    'pango'
    'cairo'
    'hyprsunset'
    'power-profiles-daemon'
    'bluez'
    'networkmanager'
)
options=('!debug' '!strip' '!buildflags')

source=(
    "ghosted-settings"
    "org.ghosted.settings.desktop"
)
sha256sums=(
    'SKIP'
    'SKIP'
)

package() {
    install -Dm755 "$srcdir/ghosted-settings" "$pkgdir/usr/bin/ghosted-settings"
    ln -s ghosted-settings "$pkgdir/usr/bin/ghosted-setting"

    install -Dm644 "$srcdir/org.ghosted.settings.desktop" "$pkgdir/usr/share/applications/org.ghosted.settings.desktop"
}
